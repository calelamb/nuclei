{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getnuclei.dev/schemas/qec-data/v1/import-chunk.schema.json",
  "title": "QEC typed import chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "payload", "source_spans"],
  "properties": {
    "record_kind": { "enum": ["syndromes", "campaign_points", "calibrations"] },
    "payload": { "type": "object" },
    "source_spans": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "source-span.schema.json" } }
  },
  "oneOf": [
    {
      "properties": {
        "record_kind": { "const": "syndromes" },
        "payload": { "$ref": "syndrome-batch.schema.json" }
      }
    },
    {
      "properties": {
        "record_kind": { "const": "campaign_points" },
        "payload": { "$ref": "campaign-point-batch.schema.json" }
      }
    },
    {
      "properties": {
        "record_kind": { "const": "calibrations" },
        "payload": { "$ref": "calibration-batch.schema.json" }
      }
    }
  ]
}
