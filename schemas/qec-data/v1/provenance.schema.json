{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getnuclei.dev/schemas/qec-data/v1/provenance.schema.json",
  "title": "QEC canonical provenance record",
  "$comment": "Executable validators MUST reject duplicate source_id and parent provenance identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provenance_id", "created_at", "sources", "adapter",
    "mapping_decisions", "unit_conversions", "revision_references", "environment",
    "parent_dataset_ids", "transformations", "filters", "exclusions", "recipes",
    "annotations", "control_audit_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "provenance_id": { "$ref": "#/$defs/nonEmpty" },
    "created_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "uri", "sha256", "policy"],
        "properties": {
          "source_id": { "$ref": "#/$defs/nonEmpty" },
          "uri": { "$ref": "#/$defs/nonEmpty" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "policy": { "enum": ["copy", "reference"] }
        }
      }
    },
    "adapter": { "$ref": "#/$defs/identity" },
    "mapping_decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "unit_conversions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "source_unit", "canonical_unit", "factor", "offset"],
        "properties": {
          "field": { "$ref": "#/$defs/nonEmpty" }, "source_unit": { "$ref": "#/$defs/nonEmpty" },
          "canonical_unit": { "$ref": "#/$defs/nonEmpty" }, "factor": { "type": "number" }, "offset": { "type": "number" }
        }
      }
    },
    "revision_references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "runtime_version", "dependencies"],
      "properties": {
        "runtime": { "$ref": "#/$defs/nonEmpty" }, "runtime_version": { "$ref": "#/$defs/nonEmpty" },
        "dependencies": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "parent_dataset_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "transformations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "filters": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "exclusions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "control_audit_refs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "version": { "$ref": "#/$defs/nonEmpty" } }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["field", "decision", "reason"],
      "properties": { "field": { "$ref": "#/$defs/nonEmpty" }, "decision": { "$ref": "#/$defs/nonEmpty" }, "reason": { "type": "string" } }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": { "kind": { "$ref": "#/$defs/nonEmpty" }, "id": { "$ref": "#/$defs/nonEmpty" } }
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" }, "version": { "$ref": "#/$defs/nonEmpty" },
        "parameters": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    }
  }
}
