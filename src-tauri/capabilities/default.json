{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "^https://(www\\.)?youtube\\.com/.*" },
        { "url": "^https://youtu\\.be/.*" },
        { "url": "^/.*" },
        { "url": "^[A-Za-z]:\\\\.*" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**/*.py" },
        { "path": "$HOME/**/*.qasm" },
        { "path": "$HOME/**/*.ipynb" },
        { "path": "$HOME/**/*.yaml" },
        { "path": "$HOME/**/*.yml" },
        { "path": "$HOME/**/*.json" },
        { "path": "$HOME/**/*.txt" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**/*.py" },
        { "path": "$HOME/**/*.qasm" },
        { "path": "$HOME/**/*.ipynb" },
        { "path": "$HOME/**/*.yaml" },
        { "path": "$HOME/**/*.yml" },
        { "path": "$HOME/**/*.json" },
        { "path": "$HOME/**/*.txt" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
